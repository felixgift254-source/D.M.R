# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to version control.

# PostgreSQL connection string (production)
# Example: postgresql://user:password@localhost:5432/dmr_prod
DATABASE_URL="postgresql://user:password@localhost:5432/dmr_dev"

# JWT secret — must be a long, random, unpredictable string (min 64 chars recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# AES-256 encryption key — must be EXACTLY 32 bytes when UTF-8 encoded
# Generate: node -e "require('crypto').randomBytes(32).toString('latin1')" 
ENCRYPTION_KEY="replace-with-exactly-32-byte-key"

# Server port
PORT=5000

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL="http://localhost:3000"

# Node environment: development | production
NODE_ENV="development"

# Log level: trace | debug | info | warn | error
LOG_LEVEL="info"
