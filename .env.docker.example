# Docker environment template for DMR System
# Copy this file to .env.docker before running docker compose:
# cp .env.docker.example .env.docker

# PostgreSQL
POSTGRES_USER=dmr_user
POSTGRES_PASSWORD=dmr_docker_pass_2026
POSTGRES_DB=dmr_dev

# Backend
DATABASE_URL=postgresql://dmr_user:dmr_docker_pass_2026@dmr-db:5432/dmr_dev
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
ENCRYPTION_KEY=replace-with-exactly-32-byte-hex-key
PORT=5000
FRONTEND_URL=http://localhost
NODE_ENV=production
LOG_LEVEL=info
